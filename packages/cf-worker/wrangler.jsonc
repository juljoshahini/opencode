{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencode-cf",
  "account_id": "dd19b3003dd56b861eb0a6aa4e9d8d19",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "OpenCodeSession",
      "image": "../cf-container/Dockerfile",
      "image_build_context": "../..",
      "name": "opencode-session",
      "instance_type": "standard-1",
      "max_instances": 50
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "OpenCodeSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OpenCodeSession"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "opencode-test"
    }
  ]
}
